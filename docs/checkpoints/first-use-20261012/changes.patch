+import { Text, View } from "react-native";
+import { exampleStatements, startingHistory } from "@/lib/home-start";
+import { colors, typography } from "@/theme/tokens";
+
+// The same fictional statements and calculation used by the full example.
+const history = startingHistory(exampleStatements, true, "2026-07-01")!;
+export function BillExamplePreview() {
+  return <View style={{ width: "100%", maxWidth: 430, borderRadius: 22, padding: 20, gap: 12, backgroundColor: "#EFE4D0" }}>
+    <Text style={[typography.caption, { color: colors.mutedForeground }]}>EXAMPLE · ELECTRICITY · CAD</Text>
+    <Text accessibilityRole="header" style={[typography.section, { color: colors.foreground }]}>What changed on this bill?</Text>
+    <View style={{ gap: 8 }}>
+      {[...history.analysis.window].reverse().map((period, index) => <View key={period.bill.id} style={{ gap: 4 }}>
+        <View style={{ flexDirection: "row", gap: 8, flexWrap: "wrap", justifyContent: "space-between" }}>
+          <Text style={[typography.meta, { color: colors.foreground }]}>{["April", "May", "June"][index]}</Text>
+          <Text style={[typography.meta, { color: colors.foreground }]}>${(period.dailyMinor / 100).toFixed(2)} / day</Text>
+        </View>
+        <View accessible={false} style={{ height: 6, backgroundColor: "#E0D4BD", borderRadius: 3 }}>
+          <View style={{ height: 6, width: `${period.dailyMinor / 360 * 100}%`, borderRadius: 3, backgroundColor: index === 2 ? colors.primary : "#AC9569" }} />
+        </View>
+      </View>)}
+    </View>
+    <Text style={[typography.body, { color: colors.foreground, fontWeight: "600" }]}>Daily charges rose {history.analysis.comparison!.percent}%</Text>
+    <Text style={[typography.caption, { color: colors.mutedForeground }]}>Check the original for usage or price changes. Totals alone don’t tell us the cause.</Text>
+  </View>;
+}
--- before/apps/mobile/src/lib/import-journey.ts
+++ after/apps/mobile/src/lib/import-journey.ts
@@ -0,0 +1,27 @@
+type ImportProgress = { status: string; authenticated?: boolean; saved: number; originals?: number };
+
+// Authorization, saved results and a complete import are separate milestones.
+export function importJourney(progress: ImportProgress) {
+  const active = ["preparing", "queued", "running", "verification"].includes(progress.status);
+  const needsPresence = active && (progress.status === "verification" || progress.authenticated !== true);
+  const stopped = ["canceled", "cancelled"].includes(progress.status);
+  const complete = progress.status === "completed";
+  const partial = progress.status === "partial";
+  const failed = progress.status === "failed";
+  const title = needsPresence ? progress.status === "verification" ? "Verify your sign-in" : "Stay for sign-in"
+    : stopped ? "Import stopped"
+    : failed ? "Your import needs attention"
+    : complete ? progress.saved > 0 ? "Your bill history is ready" : "No bills in this date range"
+    : partial ? progress.saved > 0 ? "Some bills are saved" : "No bills saved yet"
+    : active ? progress.saved > 0 ? "Your latest bills are ready" : "We’ll take it from here"
+    : "Check your import status";
+  const original = (progress.originals ?? 0) > 0 ? " Open an available original PDF to check the details." : "";
+  const next = progress.saved > 0
+    ? progress.saved === 1
+      ? "Start with your saved bill: review the charges." + original + " Comparisons need another usable period for the same account."
+      : "Open a saved bill to review its charges." + original + " Compare available periods for the same account in Bills."
+    : complete ? "Your provider returned no bills for the requested dates. You can upload a statement instead."
+    : stopped || failed || partial ? "You can retry from this connection or upload a statement instead."
+    : null;
+  return { active, needsPresence, title, next };
+}
