{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "developmentClient": false,
      "channel": "staging"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "developmentClient": false,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SOCIAL_AUTH_READY": "true",
        "EXPO_PUBLIC_APPLE_AUTH_READY": "true",
        "EXPO_PUBLIC_EMAIL_CODE_READY": "true"
      },
      "channel": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "staging-android": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SOCIAL_AUTH_READY": "true",
        "EXPO_PUBLIC_EMAIL_CODE_READY": "true"
      },
      "autoIncrement": true
    },
    "beta": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "developmentClient": false,
      "env": {
        "EXPO_NO_DOTENV": "1",
        "EXPO_PUBLIC_SOCIAL_AUTH_READY": "true",
        "EXPO_PUBLIC_EMAIL_CODE_READY": "true"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "staging"
    },
    "apple-beta": {
      "extends": "beta",
      "env": {
        "EXPO_PUBLIC_APPLE_AUTH_READY": "true"
      }
    },
    "apple-staging-android": {
      "extends": "staging-android",
      "env": {
        "EXPO_PUBLIC_APPLE_AUTH_READY": "true"
      }
    },
    "production-candidate": {
      "extends": "production",
      "channel": "production-candidate",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {},
    "beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "ascAppId": "6817197470"
      }
    }
  }
}
